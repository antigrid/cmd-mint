{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmd-mint.local/schemas/report.schema.json",
  "title": "cmd-mint report.json",
  "description": "Stable JSON contract for the safe report.json artifact generated by cmd-mint.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "summary",
    "exclusions"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "$ref": "#/$defs/aggregate_summary"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source_summary"
      }
    },
    "top_tools": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tool_summary"
      }
    },
    "alias_suggestions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/alias_suggestion"
      }
    },
    "tool_sections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tool_section"
      }
    },
    "patterns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pattern_summary"
      }
    },
    "exclusions": {
      "$ref": "#/$defs/exclusion_summary"
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/warning"
      }
    }
  },
  "$defs": {
    "aggregate_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_sources_scanned",
        "safe_commands_analyzed",
        "sensitive_commands_skipped",
        "risky_commands_excluded",
        "alias_conflicts_skipped",
        "total_entries_read",
        "total_entries_parsed",
        "total_entries_skipped"
      ],
      "properties": {
        "total_sources_scanned": {
          "$ref": "#/$defs/non_negative_integer"
        },
        "safe_commands_analyzed": {
          "$ref": "#/$defs/non_negative_integer"
        },
        "sensitive_commands_skipped": {
          "$ref": "#/$defs/non_negative_integer"
        },
        "risky_commands_excluded": {
          "$ref": "#/$defs/non_negative_integer"
        },
        "alias_conflicts_skipped": {
          "$ref": "#/$defs/non_negative_integer"
        },
        "total_entries_read": {
          "$ref": "#/$defs/non_negative_integer"
        },
        "total_entries_parsed": {
          "$ref": "#/$defs/non_negative_integer"
        },
        "total_entries_skipped": {
          "$ref": "#/$defs/non_negative_integer"
        },
        "top_tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tool_summary"
          }
        }
      }
    },
    "source_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_shell",
        "source_file",
        "entries_read",
        "entries_parsed",
        "entries_skipped"
      ],
      "properties": {
        "source_shell": {
          "$ref": "#/$defs/shell"
        },
        "source_file": {
          "type": "string"
        },
        "entries_read": {
          "$ref": "#/$defs/non_negative_integer"
        },
        "entries_parsed": {
          "$ref": "#/$defs/non_negative_integer"
        },
        "entries_skipped": {
          "$ref": "#/$defs/non_negative_integer"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "tool_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "count"
      ],
      "properties": {
        "tool": {
          "type": "string"
        },
        "count": {
          "$ref": "#/$defs/non_negative_integer"
        }
      }
    },
    "alias_suggestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "command",
        "frequency",
        "estimated_saved_per_use",
        "estimated_saved_total",
        "confidence"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "frequency": {
          "$ref": "#/$defs/non_negative_integer"
        },
        "estimated_saved_per_use": {
          "$ref": "#/$defs/non_negative_integer"
        },
        "estimated_saved_total": {
          "$ref": "#/$defs/non_negative_integer"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "reason": {
          "type": "string"
        },
        "source_shells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/shell"
          }
        },
        "alias_file_eligible": {
          "type": "boolean"
        },
        "exclusion_reasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/exclusion_reason"
          }
        }
      }
    },
    "tool_section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "count"
      ],
      "properties": {
        "tool": {
          "type": "string"
        },
        "count": {
          "$ref": "#/$defs/non_negative_integer"
        },
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/safe_command_summary"
          }
        },
        "subcommands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/subcommand_summary"
          }
        }
      }
    },
    "safe_command_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "count"
      ],
      "properties": {
        "command": {
          "type": "string"
        },
        "normalized_command": {
          "type": "string"
        },
        "count": {
          "$ref": "#/$defs/non_negative_integer"
        },
        "tool": {
          "type": "string"
        },
        "subcommand": {
          "type": "string"
        },
        "source_shells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/shell"
          }
        },
        "risk_flags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/risk_flag"
          }
        },
        "exclusion_reasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/exclusion_reason"
          }
        }
      }
    },
    "subcommand_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subcommand",
        "count"
      ],
      "properties": {
        "subcommand": {
          "type": "string"
        },
        "count": {
          "$ref": "#/$defs/non_negative_integer"
        }
      }
    },
    "pattern_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pattern",
        "count"
      ],
      "properties": {
        "pattern": {
          "type": "string"
        },
        "count": {
          "$ref": "#/$defs/non_negative_integer"
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "exclusion_summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "by_reason": {
          "$ref": "#/$defs/exclusion_reason_counts"
        },
        "existing_alias_conflicts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "risky_categories": {
          "$ref": "#/$defs/risk_flag_counts"
        },
        "sensitive_categories": {
          "$ref": "#/$defs/sensitivity_flag_counts"
        },
        "multiline_command_count": {
          "$ref": "#/$defs/non_negative_integer"
        },
        "low_frequency_command_count": {
          "$ref": "#/$defs/non_negative_integer"
        },
        "too_short_command_count": {
          "$ref": "#/$defs/non_negative_integer"
        },
        "malformed_command_count": {
          "$ref": "#/$defs/non_negative_integer"
        },
        "ignored_tool_command_count": {
          "$ref": "#/$defs/non_negative_integer"
        }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "source_file": {
          "type": "string"
        }
      }
    },
    "exclusion_reason_counts": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/exclusion_reason"
      },
      "additionalProperties": {
        "$ref": "#/$defs/non_negative_integer"
      }
    },
    "risk_flag_counts": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/risk_flag"
      },
      "additionalProperties": {
        "$ref": "#/$defs/non_negative_integer"
      }
    },
    "sensitivity_flag_counts": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/sensitivity_flag"
      },
      "additionalProperties": {
        "$ref": "#/$defs/non_negative_integer"
      }
    },
    "shell": {
      "enum": [
        "auto",
        "bash",
        "zsh",
        "fish"
      ]
    },
    "exclusion_reason": {
      "enum": [
        "sensitive_secret",
        "sensitive_credential_file",
        "sensitive_database_url",
        "sensitive_auth_header",
        "sensitive_private_key",
        "sensitive_clipboard_or_keychain",
        "risky_destructive",
        "risky_production_action",
        "multiline",
        "parse_failed",
        "too_short",
        "low_frequency",
        "low_savings",
        "alias_conflict",
        "unsupported_shell",
        "unreadable_source",
        "malformed_entry",
        "ignored_tool"
      ]
    },
    "risk_flag": {
      "enum": [
        "destructive",
        "production_action"
      ]
    },
    "sensitivity_flag": {
      "enum": [
        "secret",
        "credential_file",
        "database_url",
        "auth_header",
        "private_key",
        "clipboard_or_keychain"
      ]
    },
    "non_negative_integer": {
      "type": "integer",
      "minimum": 0
    }
  }
}
